{
  "name": "zaya",
  "version": "6.2.0",
  "private": true,
  "description": "Zaya – 3D PDF flipbook reader. Static site; this package only carries dev tooling.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "http-server -p 8080 -c-1 .",
    "check": "node tools/check-syntax.mjs && node tools/check-version.mjs",
    "lint": "eslint -c tools/eslint.config.mjs .",
    "test": "playwright test -c tools/playwright.config.mjs",
    "build:css": "tailwindcss -c tools/tailwind.config.js -i lib/css/tailwind.src.css -o lib/css/vendor/tailwind.css --minify",
    "build:changelog": "esbuild lib/js/features/changelog/changelog.js --bundle --format=iife --outfile=lib/js/features/changelog/changelog.bundle.js",
    "build:assets": "npm run build:css && npm run build:changelog"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.5.1",
    "@playwright/test": "^1.47.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "http-server": "^14.1.1",
    "marked": "^12.0.2",
    "tailwindcss": "^3.4.19",
    "toastify-js": "^1.12.0"
  }
}
